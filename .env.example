# Office PIN or password. Staff never use this — they tap their name.
# At least 4 characters. 2468 is only a starter for a first run on your computer.
# Change it before the team relies on Staff Note.
ADMIN_PIN=2468

# Leave both of these blank to save on this computer, in data/staff-note.json.
# That is fine locally. On Vercel the disk is temporary, so set both before deploy.
# Use the service role key on the server only. Do not prefix it with NEXT_PUBLIC_.
# The browser never talks to Supabase, so an anon key is not used.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
